<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/personal-vpn.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PersonalVPN</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PersonalVpn.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SingBoxHash</_Parameter1><_Parameter2>$(SingBoxHash)</_Parameter2>
    </AssemblyAttribute>
    <Resource Include="Assets/personal-vpn.ico"/>
    <EmbeddedResource Include="Assets/personal-vpn.ico" LogicalName="PersonalVpn.TrayIcon.ico"/>
  </ItemGroup>
</Project>
